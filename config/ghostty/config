# Ghostty config — aligned with the Alacritty setup in config/alacritty/.
# Source of truth lives here; ~/.config/ghostty is symlinked to this dir.

# ── Font ────────────────────────────────────────────────────────────────────
# Primary = Maple Mono Normal CN. Sarasa Mono SC was 1:2 width-aligned but its
# CJK glyphs come from Source Han Sans (large face, heavy strokes) while latin
# comes from Iosevka (light, narrow) — so Chinese read visibly larger/bolder
# than latin, and that imbalance can't be tuned away (Ghostty has no per-CJK
# scaling). Maple Mono CN is built specifically to balance CJK vs latin visual
# weight (smaller CJK face tuned to match latin). Fallback = JetBrainsMono Nerd
# Font Mono for Nerd Font icons (tmux/lvim statusline). Ghostty tries families
# top-down per glyph.
font-family = Maple Mono Normal CN
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
# `font-style` takes the style string the font advertises (e.g. "SemiBold"),
# NOT the full font name. Maple has Medium, so italic stays a step lighter than
# normal (Medium Italic). JetBrainsMono shares these style names, so the icon
# fallback resolves identically.
font-style = SemiBold
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = SemiBold Italic

# ── Terminal identity ───────────────────────────────────────────────────────
# Mirror Alacritty's [env] TERM. tmux.conf declares truecolor via the
# `,*:Tc` terminal-override (which fires for any non-Apple_Terminal host), so
# Ghostty's 24-bit color reaches tmux/lvim regardless of this TERM string.
# Keeping xterm-256color also means SSH remotes without xterm-ghostty terminfo
# keep working. Switch to `xterm-ghostty` if you install that terminfo on the
# hosts you use and want full feature parity locally.
term = xterm-256color

# ── Option key = Alt/Meta (the requested Option shortcuts) ──────────────────
# Replaces the entire block of Alt+A..Z / Alt+Shift+A..Z / Alt+0..9 / Alt+.
# bindings from alacritty.toml: Option now sends ESC-prefixed sequences, so
# shell forward/backward-word (Option+f/b), tmux meta keys, and lvim/which-key
# mappings all work. Tradeoff: Option loses its macOS special-char input
# (Option+f no longer types "ƒ"). Use `left` or `right` instead of `true` to
# keep special chars on just one Option key.
macos-option-as-alt = true

# ── Cursor (Alacritty: style block, blinking On) ────────────────────────────
cursor-style = block
cursor-style-blink = true

# ── Window ──────────────────────────────────────────────────────────────────
# Alacritty: decorations = "buttonless" → hide the title bar, keep lights.
macos-titlebar-style = hidden
# Alacritty: window.padding x=5 y=0 + dynamic_padding = true. Balance splits
# the leftover (sub-cell) space on both axes, centering content like dynamic
# padding does.
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

# ── Keybinds ────────────────────────────────────────────────────────────────
# Shift+Enter → ESC + CR, matching alacritty.toml's Shift+Return binding.
keybind = shift+enter=text:\x1b\r
macos-option-as-alt = true
# Ctrl+Space → NUL (\x00): Ghostty sends this by default (xterm behavior), so
# no explicit binding is needed — alacritty.toml had one because Alacritty
# didn't emit NUL on its own.

# ── Background image ───────────────────────────────────────────────────────
# Bright, right-weighted photo: keep the subject visible while preserving
# contrast for light One Dark text by mixing the image in lightly.
background-image = /Users/awu/Desktop/workplace/gundam/01.jpg
background-image-fit = cover
background-image-position = center-right
background-image-repeat = false
background-image-opacity = 0.03

# ── Colors: One Dark (navarasu/onedark.nvim "dark" — matches onedark.toml) ──
background = #282c34
foreground = #abb2bf
cursor-color = #abb2bf
cursor-text = #282c34

